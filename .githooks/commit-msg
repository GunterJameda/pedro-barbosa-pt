#!/bin/sh
# Commit messages are one line, at most 64 characters, in Conventional Commits format.

# Drops the diff added by `git commit -v`, then comments and trailing blank lines.
message=$(sed '/^# -* >8 -*$/,$d' "$1" | grep -v '^#')

case "$message" in
  "Merge "*) exit 0 ;;
esac

fail() {
  echo "Invalid commit message: $1" >&2
  echo "Expected one line of at most 64 characters, like: fix(navbar): keep links on one row" >&2
  echo "Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert" >&2
  exit 1
}

[ -n "$message" ] || fail "it's empty"
[ "$(printf '%s\n' "$message" | wc -l)" -eq 1 ] || fail "it has more than one line"
[ "${#message}" -le 64 ] || fail "it has ${#message} characters"

printf '%s\n' "$message" |
  grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: [^ ].*$' ||
  fail "it doesn't follow the convention"
