{
  "name": "pedro-barbosa-pt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs && vitest run",
    "test:e2e": "yarn build && playwright test",
    "test:e2e:prod": "E2E_BASE_URL=https://pedrobarbosa.pt playwright test",
    "postinstall": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@vercel/analytics": "^2.0.1",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "jsdom": "30.1.3",
    "playwright-core": "1.64.1",
    "typescript": "^5",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "packageManager": "yarn@4.18.1"
